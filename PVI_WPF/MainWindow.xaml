<Window x:Class="PVI_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PVI_WPF"
        mc:Ignorable="d"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:halcon="http://schemas.mvtec.com/halcondotnet"
        Title="HALCON视觉检测"
        Height="850" Width="1450"
        
        PreviewKeyDown="Window_PreviewKeyDown"
        
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>
    
    <Window.InputBindings>
        <KeyBinding Key="Right" Command="{Binding NextImageCommand}"/>
    </Window.InputBindings>
        
    <Window.Resources>
        <Style TargetType="Button" x:Key="windowOperateBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF1E90FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF104E8B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="UserOperateBtn">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Width" Value="95"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="LightGray"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Background="#1171D1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <TextBlock Text="HALCON视觉检测" Foreground="White" FontWeight="Bold" FontSize="18"
                       VerticalAlignment="Center" Margin="10,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="-" Width="40" FontSize="20" Margin="5,0"
                        Style="{StaticResource windowOperateBtn}" Click="Minimize_Click"/>
                <Button Content="□" Width="40" FontSize="16" Margin="5,0"
                        Style="{StaticResource windowOperateBtn}" Click="Maximize_Click"/>
                <Button Content="×" Width="40" FontSize="18" Margin="5,0"
                        Style="{StaticResource windowOperateBtn}" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <!-- Row 1 -->
        <Border Grid.Row="1" Background="#FFE0F0FF" BorderThickness="0,0,0,1" BorderBrush="Black">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource UserOperateBtn}" Content="选择文件夹" Margin="20,0,5,0"
                            Command="{Binding SelectFolderCommand}"/>


                    <ToggleButton IsChecked="{Binding IsAutoScroll, Mode=TwoWay}" Content="手动切换" Margin="5,-4,5,0" VerticalAlignment="Center">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <StackPanel Orientation="Vertical">
                                    <Grid>
                                        <Border CornerRadius="14" Height="30" Width="55" BorderThickness="0" Background="#3B82F6" BorderBrush="#3B82F6" Margin="5,5,5,0">
                                            <Border x:Name="P" Height="27" Width="27" Background="#FFFCBE47" CornerRadius="20" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="text" Margin="0,2,0,0" FontSize="16" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="P" Property="HorizontalAlignment" Value="Right"/>
                                        <Setter TargetName="P" Property="Margin" Value="0,0,2,0"/>
                                        <Setter TargetName="text" Property="Text" Value="自动切换"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter TargetName="P" Property="HorizontalAlignment" Value="Left"/>
                                        <Setter TargetName="P" Property="Margin" Value="2,0,0,0"/>
                                        <Setter TargetName="text" Property="Text" Value="手动切换"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <TextBlock Text="切换间隔" VerticalAlignment="Center" Margin="5,0"/>

                    <TextBox Width="50" VerticalAlignment="Center" Margin="5,0"
                             VerticalContentAlignment="Center"
                             Text="{Binding TimerInterval, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="ms" VerticalAlignment="Center" Margin="2,0,40,0"/>


                    <Button Style="{StaticResource UserOperateBtn}" Content="上一页 ←" Margin="5,0"
                            Command="{Binding PreviousImageCommand}" ToolTip="快捷键：← 或 PageUp"/>
                    <Button Style="{StaticResource UserOperateBtn}" Content="下一页 →" Margin="5,0"
                            Command="{Binding NextImageCommand}" ToolTip="快捷键：→ 或 PageDown"/>
                    <TextBlock Margin="20,0,0,0" VerticalAlignment="Center"
                               Text="图片选择" FontSize="16"/>
                    <ComboBox ItemsSource="{Binding Images}"
                              DisplayMemberPath="ImageName"
                              SelectedItem="{Binding SelectedImage}"
                               VerticalContentAlignment="Center" Width="150" Height="40"
                              Margin="10,0,0,0"/>
                </StackPanel>

                    <TextBlock Text="{Binding FolderPath}" Margin="0,0,15,0" VerticalAlignment="Center"
           HorizontalAlignment="Right" Foreground="Blue" FontSize="15"
           MaxWidth="420" TextTrimming="CharacterEllipsis" ToolTip="当前文件夹 路径"/>
            </Grid>
        </Border>

        
        <!--Row 2-->
        <Grid Grid.Row="2" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <halcon:HSmartWindowControlWPF  Grid.Column="0" x:Name="HalconView" Margin="10,5,0,10"
                                           HKeepAspectRatio="True"
                                           HDisableAutoResize="False"
                                           HZoomContent="WheelForwardZoomsIn"
                                           HMoveContent="True"
                                           HDoubleClickToFitContent="True"/>
            <!--TableControl-->
            <TabControl BorderBrush="Black" Grid.Column="1" Margin="10">
                <TabItem Header="检测结果" Width="145">
                    <!--全写Border里-->
                    <Border CornerRadius="5" BorderThickness="1" BorderBrush="LightGray">
                        <StackPanel Orientation="Vertical">
                            <DataGrid Height="550" ItemsSource="{Binding PillResults}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="FontSize" Value="22"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="序号"   Binding="{Binding index}" Width="60"/>
                                    <DataGridTextColumn Header="行"     Binding="{Binding Row}" Width="60"/>
                                    <DataGridTextColumn Header="列"     Binding="{Binding Col}" Width="60"/>
                                    <DataGridTextColumn Header="角度"   Binding="{Binding AngleDeg}" Width="80"/>
                                    <DataGridTextColumn Header="面积"   Binding="{Binding Area}" Width="75"/>
                                    <DataGridTextColumn Header="检测结果"  Binding="{Binding VerdictText}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="{Binding ResultSummary,StringFormat='检测结果:{0}'}"
                                       FontSize="15" Margin="10,5,0,0" HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource UserOperateBtn}" Content="重新检测" Margin="5,0"
Command="{Binding DetectCommand}" BorderBrush="LightGray" BorderThickness="0.8"/>
                                <Button Style="{StaticResource UserOperateBtn}"
                                    Content="导出CSV" BorderThickness="0.5" BorderBrush="LightGray"
                                    HorizontalAlignment="Left" Margin="20,0,0,0"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </TabItem>
                
                <TabItem Header="参数" Width="145">
                    <Grid>
                    <Border CornerRadius="5" BorderThickness="1" BorderBrush="LightGray">
                        <StackPanel Orientation="Vertical">
                            <local:ParamPanel DataContext="{Binding Params}"/>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{Binding ResultSummary,StringFormat='检测结果:{0}'}"
           FontSize="15" Margin="10,0,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                        <StackPanel Orientation="Horizontal"  HorizontalAlignment="Right" VerticalAlignment="Bottom"
 Margin="0,0,20,50">
                            <Button Style="{StaticResource UserOperateBtn}" Content="重新检测 R" Margin="5,0"
                            Command="{Binding DetectCommand}" BorderBrush="LightGray" BorderThickness="0.8"
                            ToolTip="快捷键：R（改完参数点它 / 按 R）"/>
                            <Button Content="⚙ 配置" BorderThickness="1.5"
                                Style="{StaticResource UserOperateBtn}" Click="set"
                               >
                                <!--屎山TV最新力作-->
                                <Button.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="IndianRed" Offset="0"/>
                                        <GradientStop Color="LightGreen" Offset="0.4"/>
                                        <GradientStop Color="LightGreen" Offset="0.6"/>
                                        <GradientStop Color="Gold" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.BorderBrush>
                                <Button.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="Gray" Offset="0"/>
                                        <GradientStop Color="LightGreen" Offset="0.6"/>
                                        <GradientStop Color="LightBlue" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Foreground>
                            </Button>
                        </StackPanel>
                    </Grid>
                </TabItem>
 
                <TabItem Header="日志" Width="145">
                    <Border CornerRadius="5" BorderThickness="1" BorderBrush="LightGray">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="5">
                                <TextBlock VerticalAlignment="Center" Margin="0,0,5,0" Text="等级筛选"/>
                                <ComboBox SelectedIndex="0" Width="60" Height="25" SelectedValue="{Binding SelectedFilter}" SelectedValuePath="Content">
                                    <ComboBoxItem Content="全部"/>
                                    <ComboBoxItem Content="警告"/>
                                    <ComboBoxItem Content="错误"/>
                                    <ComboBoxItem Content="信息"/>
                                </ComboBox>
                            </StackPanel>
                            <ListBox x:Name="LogList" ItemsSource="{Binding LogsItemsView}"
                                     Grid.Row="1"
                 FontFamily="Consolas" FontSize="12"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding TimeText}" Foreground="Gray" Width="90"/>
                                        <TextBlock x:Name="lv" Text="{Binding LevelText}" Width="38"/>
                                        <TextBlock Text="{Binding Tag}" Foreground="#1171D1" Width="72"
                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock TextWrapping="Wrap" Text="{Binding Message}"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding level}" Value="Warn">
                                            <Setter TargetName="lv" Property="Foreground" Value="DarkOrange"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding level}" Value="Error">
                                            <Setter TargetName="lv" Property="Foreground" Value="Red"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>

        </Grid>

        <!--Row 3-->
        <Border Grid.Row="3" Background="#FFE0F0FF" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding CurrentFileName}" VerticalAlignment="Center"
                           FontSize="15" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center"
                           Margin="16,0" FontSize="14" Foreground="#444444"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Grid.Column="2" Text="{Binding ProgressText}" VerticalAlignment="Center"
                           Margin="16,0" FontSize="15" Foreground="#1171D1"/>
                    <TextBlock Text="{Binding ImageInfoText}" VerticalAlignment="Center"
                           Margin="16,0" FontSize="14" Foreground="#666666"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>